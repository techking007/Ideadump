<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.css">

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Welcome to your Dashboard, <span id="username"><%= user.username %></span>!</h1>

        <h2>Save a New Idea</h2>
        <form id="newIdeaForm">
            <input type="text" id="title" placeholder="Idea Title" required>
            <textarea id="description" placeholder="Idea Description"></textarea>
            <button type="submit">Save Idea</button>
        </form>

        <h2>Your Saved Ideas</h2>
        <ul id="ideaList">
            <% if (ideas && ideas.length > 0) { %>
                <% ideas.forEach(idea => { %>
                    <li>
                        <strong><%= idea.title %></strong>
                        <div class="markdown-body"><%- marked.parse(idea.description || '') %></div>
                        <div class="actions">
                            <button class="edit-button" data-id="<%= idea._id %>" data-title="<%= idea.title %>" data-description="<%= idea.description %>">Edit</button>
                            <button class="delete-button" data-id="<%= idea._id %>">Delete</button>
                        </div>
                    </li>
                <% }); %>
            <% } else { %>
                <p>No ideas saved yet!</p>
            <% } %>
        </ul>
    </div>
    <button id="logoutButton">Logout</button>

    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close-button">&times;</span>
            <h2>Edit Idea</h2>
            <form id="editIdeaForm">
                <input type="hidden" id="editIdeaId">
                <label for="editTitle">Title:</label>
                <input type="text" id="editTitle" required>
                <label for="editDescription">Description:</label>
                <textarea id="editDescription"></textarea>
                <div class="form-actions">
                    <button type="submit" id="updateIdeaButton">Update Idea</button>
                    <button type="button" id="cancelEditModalButton">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="/js/dashboard.js"></script>
</body>
</html>